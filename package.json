{
  "name": "workdesk-360-monorepo",
  "version": "1.0.0-rc.7",
  "private": true,
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter temin360-desktop run install-deps",
    "dev": "pnpm dev:temin",
    "dev:temin": "pnpm --filter temin360-desktop dev",
    "dev:ihale": "pnpm --filter ihale360-desktop dev",
    "dev:2886": "pnpm --filter devlet-ihale-2886-desktop dev",
    "dev:desktop": "pnpm --filter temin360-desktop dev",
    "dev:workspace": "pnpm --filter app-workspace dev",
    "dev:web": "pnpm --filter app-web dev",
    "dev:website": "pnpm --filter app-landing dev",
    "analyze": "node scripts/analyze-codebase.mjs",
    "db:up": "docker compose up -d db pocketbase minio",
    "db:down": "docker compose down",
    "services:up": "docker compose up -d pocketbase minio",
    "minio:up": "docker compose up -d minio",
    "minio:down": "docker compose stop minio",
    "pb:up": "node scripts/start-pocketbase.js",
    "pb:docker": "docker compose up -d pocketbase",
    "pb:down": "docker compose stop pocketbase",
    "prisma:generate": "pnpm --filter app-web prisma:generate",
    "prisma:push": "pnpm --filter app-web prisma:push",
    "prisma:seed": "pnpm --filter app-web prisma:seed",
    "prisma:studio": "pnpm --filter app-web prisma:studio",
    "build:temin": "pnpm --filter temin360-desktop build",
    "build:ihale": "pnpm --filter ihale360-desktop build",
    "build:2886": "pnpm --filter devlet-ihale-2886-desktop build",
    "build:desktop": "pnpm --filter temin360-desktop build",
    "build:workspace": "pnpm --filter app-workspace build",
    "build:web": "pnpm --filter app-web build",
    "build:website": "pnpm --filter app-landing build",
    "check:schema": "node scripts/check-schema.mjs",
    "fix:schema": "node scripts/check-schema.mjs --fix",
    "pre-release": "node scripts/check-schema.mjs --fix && pnpm --filter temin360-desktop typecheck:web",
    "typecheck:temin": "pnpm --filter temin360-desktop typecheck:node && pnpm --filter temin360-desktop typecheck:web",
    "typecheck:ihale": "pnpm --filter ihale360-desktop typecheck:node && pnpm --filter ihale360-desktop typecheck:web",
    "typecheck:2886": "pnpm --filter devlet-ihale-2886-desktop typecheck:node && pnpm --filter devlet-ihale-2886-desktop typecheck:web",
    "typecheck:desktop": "pnpm --filter temin360-desktop typecheck:node && pnpm --filter temin360-desktop typecheck:web",
    "typecheck:workspace": "pnpm --filter app-workspace typecheck",
    "typecheck:web": "pnpm --filter app-web build",
    "typecheck": "pnpm typecheck:temin && pnpm typecheck:web",
    "test:temin": "pnpm --filter temin360-desktop test",
    "test:ihale": "pnpm --filter ihale360-desktop test",
    "test:2886": "pnpm --filter devlet-ihale-2886-desktop test",
    "test": "pnpm --filter temin360-desktop test",
    "test:workspace": "pnpm --filter app-workspace test",
    "test:ecosystem": "pnpm --filter @worksuite-360/contracts test",
    "test:contracts": "pnpm --filter @worksuite-360/contracts test",
    "test:e2e": "pnpm --filter temin360-desktop test:e2e",
    "format": "pnpm --filter temin360-desktop format",
    "lint": "pnpm --filter temin360-desktop lint && pnpm --filter app-web lint",
    "stats:loc": "pnpm --filter temin360-desktop stats:loc",
    "stats:loc:app": "pnpm --filter temin360-desktop stats:loc:app",
    "stats:loc:repo": "pnpm --filter temin360-desktop stats:loc:repo",
    "rebuild:electron": "npx @electron/rebuild -v 39.8.10 -f -w better-sqlite3",
    "release": "node apps/temin360-desktop/scripts/release.js",
    "release:rc": "node apps/temin360-desktop/scripts/release.js --rc",
    "release:patch": "node apps/temin360-desktop/scripts/release.js --patch",
    "release:local": "node apps/temin360-desktop/scripts/release.js --no-push",
    "release:patch:local": "node apps/temin360-desktop/scripts/release.js --patch --no-push",
    "release:publish": "node apps/temin360-desktop/scripts/release.js --patch && pnpm --filter temin360-desktop build:win",
    "release:exe": "pnpm release:publish",
    "release:dry": "node apps/temin360-desktop/scripts/release.js --dry-run",
    "release:rc:patch": "node apps/temin360-desktop/scripts/release.js --rc --patch",
    "release:rc:local": "node apps/temin360-desktop/scripts/release.js --rc --no-push",
    "release:rc:patch:local": "node apps/temin360-desktop/scripts/release.js --rc --patch --no-push",
    "release:rc:publish": "node apps/temin360-desktop/scripts/release.js --rc --patch && pnpm --filter temin360-desktop build:win",
    "release:rc:exe": "pnpm release:rc:publish",
    "release:rc:dry": "node apps/temin360-desktop/scripts/release.js --rc --dry-run"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
