<table class="standard-table w-full border-collapse">
  <thead>
    <tr>
      {{#each headers}}
        <th class="border p-2 bg-gray-100 text-left font-bold text-xs">{{this}}</th>
      {{/each}}
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
      <tr class="border-b">
        {{#each this}}
          <td class="border p-2 text-xs">{{this}}</td>
        {{/each}}
      </tr>
    {{/each}}
  </tbody>
</table>
