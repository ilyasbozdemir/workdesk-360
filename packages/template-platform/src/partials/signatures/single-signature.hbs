<div class="single-signature mt-8 flex flex-col items-end">
  <div class="signature-box text-center min-w-[200px]">
    <div class="name font-bold text-xs">{{signatory.name}}</div>
    <div class="title text-xs text-gray-600">{{signatory.title}}</div>
    <div class="sign-area h-12"></div>
    <div class="date text-xs text-gray-400">{{formatDate signatory.date}}</div>
  </div>
</div>
