<header class="shared-header">
  <div class="header-content">
    {{#if logoUrl}}
      <img src="{{logoUrl}}" alt="Logo" class="header-logo" />
    {{/if}}
    <div class="header-titles">
      <h1 class="institution-name">{{institution.name}}</h1>
      <h2 class="sub-unit">{{institution.unit}}</h2>
    </div>
  </div>
</header>
