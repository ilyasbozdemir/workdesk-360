<div class="institution-header-block text-center">
  <div class="tc-title font-bold text-xs">T.C.</div>
  <div class="inst-name font-bold text-sm">{{institution.name}}</div>
  <div class="unit-name text-xs">{{institution.unit}}</div>
  <div class="document-meta flex justify-between mt-2 text-xs">
    <span>Sayı: {{document.number}}</span>
    <span>Tarih: {{formatDate document.date}}</span>
  </div>
</div>
