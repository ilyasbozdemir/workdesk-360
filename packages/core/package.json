{
  "name": "@worksuite-360/core",
  "version": "1.0.0",
  "type": "module",
  "description": "WorkDesk 360 ekosistemi ortak çekirdek altyapı paketi (Common Types, Domain Base, Persistence, Database, Text)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./text": {
      "types": "./src/text/index.ts",
      "import": "./src/text/index.ts",
      "default": "./src/text/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
