
{
  "json.schemas": [
    {
      "fileMatch": ["dosyalar.json"],
      "url": "./dosyalar.schema.json"
    }
  ],
  "search.followSymlinks": false,
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/node_modules/**": true,
    "**/.pnpm": true,
    "**/dist": true,
    "**/out": true,
    "**/build": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/release": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.pnpm": true,
    "**/dist": true,
    "**/out": true,
    "**/build": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/release": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.pnpm/**": true,
    "**/dist/**": true,
    "**/out/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true,
    "**/release/**": true
  }
}
