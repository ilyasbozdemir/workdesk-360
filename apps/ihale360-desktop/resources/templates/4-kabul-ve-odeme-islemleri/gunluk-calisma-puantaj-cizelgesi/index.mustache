<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {{#belgeBasligi}}{{belgeBasligi}}{{/belgeBasligi}}{{^belgeBasligi}}İş Makinesi / Hizmet İşleri
      Günlük Çalışma Puantaj Çizelgesi{{/belgeBasligi}}
    </title>
    <style>
      @page {
        size: A4 landscape;
        margin: 1cm;
      }
      body {
        font-family: 'Times New Roman', Times, serif;
        font-size: 9pt;
        color: #000;
        line-height: 1.35;
        margin: 0;
        padding: 0;
        background-color: #f5f5f5;
      }
      .page-container {
        max-width: 29.7cm;
        min-height: 21cm;
        margin: 20px auto;
        padding: 1cm;
        background: white;
        box-sizing: border-box;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        position: relative;
      }
      @media print {
        body {
          background-color: white;
        }
        .page-container {
          margin: 0;
          padding: 0;
          box-shadow: none;
          max-width: none;
          min-height: 0;
          position: static;
        }
      }
      /* HEADER TABLOSU */
      .paged-header {
        display: block;
        width: 100%;
        margin-bottom: 10px;
      }
      .header-table {
        width: 100%;
        border-collapse: collapse;
      }
      .header-table td {
        vertical-align: middle;
      }
      .antet-logo {
        max-height: 65px;
        width: auto;
      }
      .antet-text {
        text-align: center;
        font-weight: bold;
        font-size: 10pt;
        line-height: 1.3;
        text-transform: uppercase;
      }
      .document-title {
        text-align: center;
        font-weight: bold;
        font-size: 12pt;
        margin: 12px 0 15px 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      /* BİLGİ DETAY TABLOSU */
      .details-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 12px;
        font-size: 8.5pt;
      }
      .details-table td {
        border: 1px solid #000;
        padding: 4px 6px;
        vertical-align: middle;
      }
      .details-label {
        background-color: #f2f2f2;
        font-weight: bold;
      }
      /* PUANTAJ MATRİS TABLOSU */
      .puantaj-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 12px;
        font-size: 8pt;
      }
      .puantaj-table th,
      .puantaj-table td {
        border: 1px solid #000;
        padding: 4px 1px;
        text-align: center;
        vertical-align: middle;
      }
      .puantaj-table th {
        font-weight: bold;
        background-color: #eaeaea;
      }
      .text-left {
        text-align: left !important;
        padding-left: 5px !important;
      }
      /* LEJANT VE BEYAN */
      .lejant-box {
        font-size: 8pt;
        border: 1px solid #000;
        padding: 5px 8px;
        margin-bottom: 10px;
        background-color: #fafafa;
        line-height: 1.4;
      }
      .kabul-beyani {
        font-size: 8.5pt;
        text-align: justify;
        margin-bottom: 15px;
        line-height: 1.4;
      }
      /* İMZA TABLOSU */
      .imza-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
        page-break-inside: avoid;
      }
      .imza-table td {
        vertical-align: top;
        text-align: center;
        font-size: 8.5pt;
        padding: 5px;
      }
      .imza-unvan {
        font-weight: bold;
        margin-bottom: 40px;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <div class="page-container">
      <!-- HEADER / ANTET -->
      <header class="paged-header">
        <table class="header-table">
          <tr>
            <td width="15%" align="left">
              {{#solLogo}}<img src="{{solLogo}}" class="antet-logo" alt="Logo" />{{/solLogo}}
            </td>
            <td width="70%" class="antet-text">
              {{#antetSatirlari}}
              <div>{{.}}</div>
              {{/antetSatirlari}} {{^antetSatirlari}}
              <div>T.C.</div>
              <div>{{kurumAdi}}</div>
              {{/antetSatirlari}}
            </td>
            <td width="15%" align="right">
              {{#sagLogo}}<img src="{{sagLogo}}" class="antet-logo" alt="Logo" />{{/sagLogo}}
            </td>
          </tr>
        </table>
      </header>

      <!-- BELGE BAŞLIĞI -->
      <div class="document-title">
        {{#belgeBasligi}}{{belgeBasligi}}{{/belgeBasligi}}{{^belgeBasligi}}İŞ MAKİNESİ / HİZMET
        İŞLERİ GÜNLÜK ÇALIŞMA PUANTAJ ÇİZELGESİ{{/belgeBasligi}}
      </div>

      <!-- İŞ VE SÖZLEŞME DETAY TABLOSU -->
      <table class="details-table">
        <tr>
          <td width="15%" class="details-label">İşin / Hizmetin Adı</td>
          <td width="35%"><b>{{dosyaKonusu}}{{^dosyaKonusu}}{{isinAdi}}{{/dosyaKonusu}}</b></td>
          <td width="15%" class="details-label">Hakediş / Çalışma Dönemi</td>
          <td width="35%"><b>{{ayYil}}</b></td>
        </tr>
        <tr>
          <td class="details-label">Yüklenici Firma</td>
          <td><b>{{yukleniciFirma}}</b></td>
          <td class="details-label">Hizmet Sunulan Birim</td>
          <td>{{hizmetYeri}}{{^hizmetYeri}}{{kurumAdi}}{{/hizmetYeri}}</td>
        </tr>
        <tr>
          <td class="details-label">Sözleşme / Temin No</td>
          <td>
            {{#teminNo}}Temin No: {{teminNo}}{{/teminNo}}{{^teminNo}}{{sozlesmeTarihi}}{{/teminNo}}
          </td>
          <td class="details-label">Kontrol Teşkilatı</td>
          <td>{{kontrolGorevlisi}}</td>
        </tr>
      </table>

      <!-- GÜNLÜK PUANTAJ VE İFA MATRİS TABLOSU -->
      <table class="puantaj-table">
        <thead>
          <tr>
            <th width="3%">S.N</th>
            <th width="16%">
              {{#kalemBasligi}}{{kalemBasligi}}{{/kalemBasligi}}{{^kalemBasligi}}HİZMET / İFA / ARAÇ
              - MAKİNE KALEMİ{{/kalemBasligi}}
            </th>
            <th width="10%">
              {{#ozellikBasligi}}{{ozellikBasligi}}{{/ozellikBasligi}}{{^ozellikBasligi}}ÖZELLİĞİ /
              PLAKA / NİTELİĞİ{{/ozellikBasligi}}
            </th>
            <th width="1.7%">1</th>
            <th width="1.7%">2</th>
            <th width="1.7%">3</th>
            <th width="1.7%">4</th>
            <th width="1.7%">5</th>
            <th width="1.7%">6</th>
            <th width="1.7%">7</th>
            <th width="1.7%">8</th>
            <th width="1.7%">9</th>
            <th width="1.7%">10</th>
            <th width="1.7%">11</th>
            <th width="1.7%">12</th>
            <th width="1.7%">13</th>
            <th width="1.7%">14</th>
            <th width="1.7%">15</th>
            <th width="1.7%">16</th>
            <th width="1.7%">17</th>
            <th width="1.7%">18</th>
            <th width="1.7%">19</th>
            <th width="1.7%">20</th>
            <th width="1.7%">21</th>
            <th width="1.7%">22</th>
            <th width="1.7%">23</th>
            <th width="1.7%">24</th>
            <th width="1.7%">25</th>
            <th width="1.7%">26</th>
            <th width="1.7%">27</th>
            <th width="1.7%">28</th>
            <th width="1.7%">29</th>
            <th width="1.7%">30</th>
            <th width="1.7%">31</th>
            <th width="4%">TOPLAM İFA MİKTARI</th>
            <th width="8%">AÇIKLAMA / TESPİT</th>
          </tr>
        </thead>
        <tbody>
          {{#hizmetKalemleri}}
          <tr>
            <td>{{siraNo}}</td>
            <td class="text-left"><b>{{kalemAdi}}</b></td>
            <td class="text-left">{{ozelligi}}</td>
            <td>{{d1}}</td>
            <td>{{d2}}</td>
            <td>{{d3}}</td>
            <td>{{d4}}</td>
            <td>{{d5}}</td>
            <td>{{d6}}</td>
            <td>{{d7}}</td>
            <td>{{d8}}</td>
            <td>{{d9}}</td>
            <td>{{d10}}</td>
            <td>{{d11}}</td>
            <td>{{d12}}</td>
            <td>{{d13}}</td>
            <td>{{d14}}</td>
            <td>{{d15}}</td>
            <td>{{d16}}</td>
            <td>{{d17}}</td>
            <td>{{d18}}</td>
            <td>{{d19}}</td>
            <td>{{d20}}</td>
            <td>{{d21}}</td>
            <td>{{d22}}</td>
            <td>{{d23}}</td>
            <td>{{d24}}</td>
            <td>{{d25}}</td>
            <td>{{d26}}</td>
            <td>{{d27}}</td>
            <td>{{d28}}</td>
            <td>{{d29}}</td>
            <td>{{d30}}</td>
            <td>{{d31}}</td>
            <td><b>{{toplamMiktar}}{{#birim}} {{birim}}{{/birim}}</b></td>
            <td class="text-left">{{aciklama}}</td>
          </tr>
          {{/hizmetKalemleri}} {{^hizmetKalemleri}} {{#personeller}}
          <tr>
            <td>{{siraNo}}</td>
            <td class="text-left"><b>{{adSoyad}}</b></td>
            <td class="text-left">{{gorevi}}</td>
            <td>{{d1}}</td>
            <td>{{d2}}</td>
            <td>{{d3}}</td>
            <td>{{d4}}</td>
            <td>{{d5}}</td>
            <td>{{d6}}</td>
            <td>{{d7}}</td>
            <td>{{d8}}</td>
            <td>{{d9}}</td>
            <td>{{d10}}</td>
            <td>{{d11}}</td>
            <td>{{d12}}</td>
            <td>{{d13}}</td>
            <td>{{d14}}</td>
            <td>{{d15}}</td>
            <td>{{d16}}</td>
            <td>{{d17}}</td>
            <td>{{d18}}</td>
            <td>{{d19}}</td>
            <td>{{d20}}</td>
            <td>{{d21}}</td>
            <td>{{d22}}</td>
            <td>{{d23}}</td>
            <td>{{d24}}</td>
            <td>{{d25}}</td>
            <td>{{d26}}</td>
            <td>{{d27}}</td>
            <td>{{d28}}</td>
            <td>{{d29}}</td>
            <td>{{d30}}</td>
            <td>{{d31}}</td>
            <td><b>{{toplamGun}}</b></td>
            <td class="text-left">{{aciklama}}</td>
          </tr>
          {{/personeller}} {{/hizmetKalemleri}}
        </tbody>
      </table>

      <!-- LEJANT BİLGİSİ -->
      <div class="lejant-box">
        {{#lejantMetni}}{{{lejantMetni}}}{{/lejantMetni}} {{^lejantMetni}}
        <b>İfa Sembolleri Lejandı:</b>
        <b>Sayısal Değer (m², Saat, Adet vb.):</b> Günlük Fiilen İfa Edilen İmalat / Çalışma Miktarı
        | <b>X:</b> Tam Gün Hizmet İfa Edildi | <b>-:</b> Çalışılmadı / Hava Muhalefeti / Tatil
        {{/lejantMetni}}
      </div>

      <!-- KABUL TESPİT BEYANI -->
      <div class="kabul-beyani">
        {{#kabulBeyani}}{{{kabulBeyani}}}{{/kabulBeyani}} {{^kabulBeyani}}
        <b>Tespit ve Kabul Beyanı:</b> Yukarıda ayrıntıları ve günlük dökümü yer alan hizmet ve
        imalatlar, yüklenici <b>{{yukleniciFirma}}</b> tarafından <b>{{ayYil}}</b> ayı çalışma
        dönemi içerisinde idaremiz denetim ve gözetiminde teknik şartname ile sözleşme/temin
        esaslarına uygun olarak yürütülmüş, fiili ölçüm ve hizmet ifa kayıtları denetlenerek
        hakedişe esas kabulü yapılmıştır. {{/kabulBeyani}}
      </div>

      <!-- İMZA ALANI -->
      <table class="imza-table">
        <tbody>
          <tr>
            <td width="33%">
              <div class="imza-unvan">
                {{#yukleniciUnvan}}{{yukleniciUnvan}}{{/yukleniciUnvan}}{{^yukleniciUnvan}}HİZMET
                SUNUCU / YÜKLENİCİ{{/yukleniciUnvan}}
              </div>
              <div><b>{{yukleniciFirma}}</b></div>
              <div>Yetkili İmza / Kaşe</div>
            </td>
            <td width="33%">
              <div class="imza-unvan">
                {{#kontrolUnvan}}{{kontrolUnvan}}{{/kontrolUnvan}}{{^kontrolUnvan}}KONTROL VE
                DENETİM TEŞKİLATI{{/kontrolUnvan}}
              </div>
              <div><b>{{kontrolGorevlisi}}</b></div>
              <div>İmza</div>
            </td>
            <td width="34%">
              <div class="imza-unvan">
                {{#komisyonUnvan}}{{komisyonUnvan}}{{/komisyonUnvan}}{{^komisyonUnvan}}MUAYENE VE
                KABUL KOMİSYONU{{/komisyonUnvan}}
              </div>
              <div><b>{{baskanAdi}}</b></div>
              <div>İmza</div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </body>
</html>
