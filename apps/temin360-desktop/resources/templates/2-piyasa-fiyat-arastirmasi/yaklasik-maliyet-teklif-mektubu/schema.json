    "solLogo": {
      "type": "string"
    },
    "sagLogo": {
      "type": "string"
    },
    "kurumUstBirim": {
      "type": "string"
    },
    "kurumBirim": {
      "type": "string"
    },
    "kurumAdi": {
      "type": "string"
    },
    "sonTeklifTarihi": {
      "type": "string"
    },
    "sonTeklifSaati": {
      "type": "string"
    },
    "baskanAdi": {
      "type": "string"
    },
    "baskanUnvan": {
      "type": "string"
    },
    "kurumAdres": {
      "type": "string"
    },
    "kurumTelefon": {
