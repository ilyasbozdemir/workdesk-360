<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Birim Fiyat Teklif Mektubu ve Cetveli</title>
    <style>
      body {
        font-family: 'Times New Roman', Times, serif;
        font-size: 10pt;
        color: #000;
        line-height: 1.35;
        margin: 0;
        padding: 0;
        background-color: #f5f5f5;
      }
      @page {
        size: A4 portrait;
        margin: 0.8cm 1.5cm 1.5cm 1.5cm;
      }
      .page-container {
        max-width: 21cm;
        min-height: 29.7cm;
        margin: 20px auto;
        padding: 1cm 1.5cm 2.5cm 1.5cm;
        background: white;
        box-sizing: border-box;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        position: relative;
      }
      .content-body {
        width: 100%;
      }
      @media print {
        body {
          background-color: white;
        }
        .page-container {
          margin: 0 auto;
          padding: 1cm 1.5cm 2.5cm 1.5cm;
          box-shadow: none;
          max-width: none;
          min-height: 29.7cm;
          position: relative;
        }
      }
      .paged-header {
        display: block;
        width: 100%;
      }
      .paged-footer {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 0 1.5cm 1.2cm 1.5cm;
        box-sizing: border-box;
      }
      .title {
        text-align: center;
        font-weight: bold;
        font-size: 12pt;
        margin: 6px 0 4px 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .subtitle {
        text-align: center;
        font-weight: bold;
        font-size: 11pt;
        margin-bottom: 8px;
      }
      .info-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 8px;
        font-size: 9.5pt;
      }
      .info-table td {
        border: 1px solid #000;
        padding: 4px 6px;
        vertical-align: middle;
      }
      .info-label {
        font-weight: bold;
        width: 30%;
        background-color: #fafafa;
      }
      .info-value {
        width: 70%;
      }
      .taahhut-box {
        border: 1px solid #000;
        padding: 5px 8px;
        font-size: 8.5pt;
        text-align: justify;
        line-height: 1.3;
        margin-bottom: 8px;
        background-color: #fff;
      }
      .items-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 6px;
        font-size: 9pt;
      }
      .items-table th,
      .items-table td {
        border: 1px solid #000;
        padding: 4px 5px;
      }
      .items-table th {
        background-color: #f2f2f2;
        font-weight: bold;
        text-align: center;
      }
      .signature-section {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-top: 12px;
        font-size: 9.5pt;
      }
      .signature-box {
        text-align: center;
        min-width: 220px;
        line-height: 1.3;
        margin-left: auto;
      }
      .editable {
        outline: none;
      }
      .editable:hover {
        background-color: rgba(0, 0, 0, 0.03);
      }
      .editable:focus {
        background-color: rgba(70, 130, 180, 0.1);
      }
    </style>
  </head>
  <body>
    <!-- TEK SAYFA BÜTÜNLEŞİK BİRİM FİYAT TEKLİF MEKTUBU VE CETVELİ -->
    <div class="page-container">
      <div class="paged-header">
        <div
          style="
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #000;
            padding-bottom: 6px;
            margin-bottom: 8px;
          "
        >
          <div style="font-weight: bold; font-size: 14pt; color: #cc0000">
            {{#if kurumLogo}}<img
              src="{{kurumLogo}}"
              style="max-height: 40px"
              alt="Logo"
            />{{else}}ACME{{/if}}
          </div>
          <div style="text-align: center; line-height: 1.2">
            <div style="font-size: 9pt; font-weight: bold">T.C.</div>
            <div style="font-size: 10.5pt; font-weight: bold">
              {{#if idareUstBirim}}{{idareUstBirim}}{{else}}SAĞLIK BAKANLIĞI{{/if}}
            </div>
            <div style="font-size: 9.5pt; font-weight: bold">
              {{#if idareAdi}}{{idareAdi}}{{else}}Ankara İl Sağlık Müdürlüğü{{/if}}
            </div>
            <div style="font-size: 8.5pt">
              {{#if altBirim}}{{altBirim}}{{else}}Destek Hizmetleri Başkanlığı (Satınalma
              Birimi){/if}}
            </div>
          </div>
          <div style="font-weight: bold; font-size: 14pt; color: #cc0000">
            {{#if kurumLogo}}<img
              src="{{kurumLogo}}"
              style="max-height: 40px"
              alt="Logo"
            />{{else}}ACME{{/if}}
          </div>
        </div>
      </div>

      <div class="content-body">
        <div style="text-align: right; font-weight: bold; margin-bottom: 4px; font-size: 9.5pt">
          <span class="editable" data-field="dosyaTarihi"
            >{{#if dosyaTarihi}}{{dosyaTarihi}}{{else if
            tarih}}{{tarih}}{{else}}07.09.2026{{/if}}</span
          >
        </div>

        <div class="title">BİRİM FİYAT TEKLİF MEKTUBU VE CETVELİ</div>
        <div class="subtitle">
          <span class="editable" data-field="hitap"
            >{{#if hitap}}{{hitap}}{{else if idareAdi}}{{idareAdi}}{{else}}KURUM / MAKAM
            ADINA{{/if}}</span
          >
        </div>

        <table class="info-table">
          <tbody>
            <tr>
              <td class="info-label">İşin Adı / Konusu</td>
              <td class="info-value">
                <span class="editable" data-field="isinAdi"
                  >{{#if isinAdi}}{{isinAdi}}{{else if
                  dosyaKonusu}}{{dosyaKonusu}}{{else}}-{{/if}}</span
                >
              </td>
            </tr>
            <tr>
              <td class="info-label">Teklif Sahibinin Adı / Ünvanı</td>
              <td class="info-value">
                <span class="editable" data-field="teklifSahibi"
                  >{{#if teklifSahibi}}{{teklifSahibi}}{{else if
                  firmaUnvani}}{{firmaUnvani}}{{else}}-{{/if}}</span
                >
              </td>
            </tr>
            <tr>
              <td class="info-label">T.C. / Vergi Kimlik No</td>
              <td class="info-value">
                <span class="editable" data-field="vergiNo"
                  >{{#if vergiNo}}{{vergiNo}}{{else if firmaVergiNo}}{{firmaVergiNo}}{{else if
                  tcKimlikNo}}{{tcKimlikNo}}{{else}}-{{/if}}</span
                >
              </td>
            </tr>
            <tr>
              <td class="info-label">Tebligat Adresi / İletişim</td>
              <td class="info-value">
                <span class="editable" data-field="tebligatAdresi"
                  >{{#if tebligatAdresi}}{{tebligatAdresi}}{{else if
                  firmaAdresi}}{{firmaAdresi}}{{else}}-{{/if}}</span
                >
              </td>
            </tr>
          </tbody>
        </table>

        <div class="taahhut-box">
          {{#if aciklama}}
          <div class="editable" data-field="aciklama">{{aciklama}}</div>
          {{else}}
          <div>
            1. Yukarıda adı ve konusu belirtilen işe / alıma ait tüm şartları okudum ve aynen kabul
            ettim.<br />
            2. Teklifimiz teklif tarihinden itibaren geçerli olup teklifimize Damga Vergisi, Harç,
            Nakliye ve Sigorta giderleri dahildir.<br />
            3. Alıma konu işin / malların tamamını aşağıdaki Birim Fiyat Teklif Cetvelinde
            belirttiğimiz birim fiyatlar üzerinden KDV HARİÇ bedel karşılığında vermeyi kabul ve
            taahhüt ederiz.
          </div>
          {{/if}}
        </div>

        <table class="items-table">
          <thead>
            <tr>
              <th style="width: 6%">S.No</th>
              <th style="width: 38%; text-align: left">
                Mal/Hizmet Kaleminin Adı ve Kısa Açıklaması
              </th>
              <th style="width: 18%; text-align: left">Özelliği</th>
              <th style="width: 9%">Birimi</th>
              <th style="width: 9%">Miktarı</th>
              <th style="width: 10%">Birim Fiyat (TL)</th>
              <th style="width: 10%">Tutarı (TL)</th>
            </tr>
          </thead>
          <tbody>
            {{#if ihtiyacKalemleri}} {{#each ihtiyacKalemleri}}
            <tr>
              <td style="text-align: center">
                {{#if siraNo}}{{siraNo}}{{else}}{{@index_1}}{{/if}}
              </td>
              <td style="text-align: left">{{malzemeAdi}}</td>
              <td style="text-align: left">{{#if ozelligi}}{{ozelligi}}{{else}}-{{/if}}</td>
              <td style="text-align: center">{{#if birimi}}{{birimi}}{{else}}-{{/if}}</td>
              <td style="text-align: right">{{miktar}}</td>
              <td style="text-align: right">{{#if birimFiyat}}{{birimFiyat}} ₺{{/if}}</td>
              <td style="text-align: right">{{#if tutar}}{{tutar}} ₺{{/if}}</td>
            </tr>
            {{/each}} {{else}}
            <tr>
              <td style="text-align: center">1</td>
              <td>-</td>
              <td>-</td>
              <td style="text-align: center">-</td>
              <td style="text-align: right">-</td>
              <td style="text-align: right"></td>
              <td style="text-align: right"></td>
            </tr>
            {{/if}}
          </tbody>
          <tfoot>
            <tr>
              <td
                colspan="5"
                style="border: none; text-align: left; padding: 4px 0; font-style: italic"
              >
                Para birimi: TL
              </td>
              <td
                style="
                  border: 1px solid #000;
                  text-align: center;
                  font-weight: bold;
                  background-color: #f2f2f2;
                "
              >
                Toplam Tutar (KDV Hariç)
              </td>
              <td
                style="border: 1px solid #000; height: 26px; text-align: right; font-weight: bold"
              >
                <span class="editable" data-field="toplamTutar"
                  >{{#if toplamTutar}}{{toplamTutar}} ₺{{/if}}</span
                >
              </td>
            </tr>
          </tfoot>
        </table>

        <div class="signature-section">
          <div style="font-style: italic; color: #333; font-size: 9pt">
            Para Birimi: Türk Lirası (TL)
          </div>
          <div class="signature-box">
            <div class="editable" data-field="tarih">
              {{#if tarih}}{{tarih}}{{else if dosyaTarihi}}{{dosyaTarihi}}{{else}}07.09.2026{{/if}}
            </div>
            <div style="margin-top: 4px; font-weight: bold">
              <span class="editable" data-field="teklifSahibi"
                >{{#if teklifSahibi}}{{teklifSahibi}}{{else if
                firmaUnvani}}{{firmaUnvani}}{{else}}Firma / Yetkili Adı{{/if}}</span
              >
            </div>
            <div style="margin-top: 16px">Kaşe - İmza</div>
          </div>
        </div>
      </div>

      <div class="paged-footer">
        <div
          style="
            display: flex;
            justify-content: space-between;
            font-size: 8pt;
            color: #666;
            border-top: 1px solid #ccc;
            padding-top: 4px;
          "
        >
          <div>4734 Sayılı KİK Doğrudan Temin Formu</div>
          <div>Sayfa 1 / 1</div>
        </div>
      </div>
    </div>
  </body>
</html>
