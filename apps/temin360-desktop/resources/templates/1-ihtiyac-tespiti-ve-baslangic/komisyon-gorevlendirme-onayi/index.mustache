<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Görevlendirme Onayı</title>
    <style>
      @page {
        size: A4;
        margin: 1.2cm 1.2cm 1.2cm 1.2cm;
      }
      body {
        font-family: 'Times New Roman', Times, serif;
        font-size: 10.5pt;
        color: #000;
        line-height: 1.35;
        margin: 0;
        padding: 0;
        background-color: #f5f5f5;
      }
      .page-container {
        max-width: 21cm;
        min-height: 29.7cm;
        margin: 20px auto;
        padding: 1.2cm 1.2cm;
        background: white;
        box-sizing: border-box;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        position: relative;
      }
      .content-body {
        width: 100%;
      }
      @media print {
        body {
          background-color: white;
        }
        .page-container {
          margin: 0;
          padding: 0;
          box-shadow: none;
          max-width: none;
          min-height: 0;
          position: static;
        }
        .no-print {
          display: none !important;
        }
      }
      .paged-header {
        display: block;
        width: 100%;
      }
      .header-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 12px;
      }
      .header-center {
        text-align: center;
        font-weight: bold;
        font-size: 11.5pt;
        line-height: 1.25;
      }
      .meta-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 10pt;
      }
      .meta-table {
        border-collapse: collapse;
      }
      .meta-table td {
        padding: 1px 8px 1px 0;
        vertical-align: top;
      }
      .meta-label {
        font-weight: bold;
        white-space: nowrap;
      }
      .center-boxed-header {
        text-align: center;
        margin: 12px 0 8px 0;
      }
      .boxed-title {
        display: inline-block;
        padding: 2px 10px;
        font-weight: bold;
        font-size: 10.5pt;
        text-transform: uppercase;
      }
      .body-paragraph {
        text-align: justify;
        text-indent: 30px;
        margin-bottom: 8px;
        line-height: 1.35;
      }
      .preparer-signature {
        float: right;
        text-align: center;
        margin-bottom: 12px;
        margin-top: 4px;
        width: 220px;
        font-size: 10pt;
      }
      .commission-title {
        text-align: center;
        font-weight: bold;
        background-color: #f2f2f2;
        border: 1px solid #000;
        padding: 3px 5px;
        font-size: 9.5pt;
        text-transform: uppercase;
      }
      .commission-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 10px;
        font-size: 9pt;
      }
      .commission-table th,
      .commission-table td {
        border: 1px solid #000;
        padding: 3px 6px;
        text-align: left;
      }
      .commission-table th {
        font-weight: bold;
        background-color: #f9f9f9;
      }
      .olur-section {
        margin-top: 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        page-break-inside: avoid;
        break-inside: avoid;
      }
      .olur-title {
        font-weight: bold;
        font-size: 10.5pt;
        margin-bottom: 3px;
      }
    </style>
  </head>
  <body>
    <div class="page-container">
      <!-- ANTET (HEADER) -->
      <div class="paged-header" data-behavior="first-page-only" data-slot="top-center">
        <table class="header-table">
          <tr>
            <td class="header-center">
              <div style="font-size: 12pt; margin-top: 2px">{{kurumAdi}}</div>
            </td>
          </tr>
        </table>
      </div>

      <!-- CONTENT BODY -->
      <div class="content-body">
        <!-- META DATA SECTION -->
        <div class="meta-row">
          <div>
            <table class="meta-table">
              <tr>
                <td class="meta-label">Sayı</td>
                <td>: {{evrakSayisi}}</td>
              </tr>
              <tr>
                <td class="meta-label">Konu</td>
                <td>: Görevlendirme</td>
              </tr>
            </table>
          </div>
          <div><strong>Tarih:</strong> {{tarih}}</div>
        </div>

        <!-- CENTERED BOXED INSTITUTION HEADER -->
        <div class="center-boxed-header">
          <div class="boxed-title">{{kurumAdi}}</div>
        </div>

        <!-- BODY TEXT -->
        <div class="body-paragraph">
          {{kurumumuz}} bünyesindeki <strong>{{isAdi}}</strong> işine ait fiyat araştırması ile
          muayene ve kabulü yapmak üzere aşağıdaki personeller görevlendirilecek olup,
        </div>
        <div class="body-paragraph" style="margin-bottom: 12px">
          Gereğini olurlarınıza arz ederim.
        </div>

        <!-- PREPARER SIGNATURE -->
        <div style="width: 100%; display: flow-root">
          <div class="preparer-signature">
            <strong>{{hazirlayanPersonelAdi}}</strong><br />
            {{hazirlayanPersonelUnvan}}
          </div>
        </div>

        <!-- COMMISSION 1: PİYASA ARAŞTIRMA VE SATINALMA KOMİSYONU -->
        <div class="commission-title">PİYASA ARAŞTIRMA VE SATINALMA KOMİSYONU</div>
        <table class="commission-table">
          <thead>
            <tr>
              <th style="width: 35%">Komisyondaki Sıfatı/Ünvanı</th>
              <th style="width: 40%">Adı, Soyadı</th>
              <th style="width: 25%">Pozisyonu</th>
            </tr>
          </thead>
          <tbody>
            {{#fiyatKomisyonu}}
            <tr>
              <td>{{gorevi}}</td>
              <td>{{adSoyad}}</td>
              <td>{{unvan}}</td>
            </tr>
            {{/fiyatKomisyonu}} {{^fiyatKomisyonu}}
            <tr>
              <td colspan="3" style="text-align: center; font-style: italic">
                Komisyon üyesi bulunmamaktadır.
              </td>
            </tr>
            {{/fiyatKomisyonu}}
          </tbody>
        </table>

        <!-- COMMISSION 2: MUAYENE KABUL VE TESLİM ALMA KOMİSYONU -->
        <div class="commission-title">MUAYENE KABUL VE TESLİM ALMA KOMİSYONU</div>
        <table class="commission-table">
          <thead>
            <tr>
              <th style="width: 35%">Komisyondaki Sıfatı/Ünvanı</th>
              <th style="width: 40%">Adı, Soyadı</th>
              <th style="width: 25%">Pozisyonu</th>
            </tr>
          </thead>
          <tbody>
            {{#muayeneKomisyonu}}
            <tr>
              <td>{{gorevi}}</td>
              <td>{{adSoyad}}</td>
              <td>{{unvan}}</td>
            </tr>
            {{/muayeneKomisyonu}} {{^muayeneKomisyonu}}
            <tr>
              <td colspan="3" style="text-align: center; font-style: italic">
                Komisyon üyesi bulunmamaktadır.
              </td>
            </tr>
            {{/muayeneKomisyonu}}
          </tbody>
        </table>

        <!-- APPROVAL / OLUR SECTION -->
        <div class="olur-section">
          <div class="olur-title">OLUR</div>
          <div style="margin-bottom: 6px">{{tarih}}</div>
          <div style="font-weight: bold; font-size: 10.5pt">{{baskanAdi}}</div>
          <div style="font-size: 10pt">{{baskanUnvan}}</div>
        </div>
      </div>
      <!-- END CONTENT BODY -->
    </div>
  </body>
</html>
