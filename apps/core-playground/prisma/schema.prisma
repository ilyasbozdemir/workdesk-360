datasource db {
  provider = "sqlite"
  url      = "file:./playground-prisma.sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

model PlaygroundItem {
  id        String   @id
  name      String
  targetApp String?  @map("target_app")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("playground_items")
}
