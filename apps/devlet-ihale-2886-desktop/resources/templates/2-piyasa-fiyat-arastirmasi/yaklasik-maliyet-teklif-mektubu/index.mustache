<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yaklaşık Maliyet Teklif Mektubu</title>
    <style>
      @page {
        size: A4;
        margin: 0.5cm 1.5cm 1.5cm 1.5cm;
      }
      body {
        font-family: 'Times New Roman', Times, serif;
        font-size: 11pt;
        color: #000;
        line-height: 1.4;
        margin: 0;
        padding: 0;
        background-color: #f5f5f5;
      }
      .page-container {
        max-width: 21cm;
        min-height: 29.7cm;
        margin: 20px auto;
        padding: 0.5cm 1.5cm 2.5cm 1.5cm;
        background: white;
        box-sizing: border-box;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        position: relative;
      }
      .content-body {
        width: 100%;
      }
      @media print {
        body {
          background-color: white;
        }
        .page-container {
          margin: 0;
          padding: 0;
          box-shadow: none;
          max-width: none;
          min-height: 0;
          position: static;
        }
      }
      .paged-header {
        display: block;
        width: 100%;
        margin-bottom: 15px;
      }
      .header-table {
        width: 100%;
        border-collapse: collapse;
        min-height: 75px;
      }
      .header-table td {
        vertical-align: top;
        padding-top: 0;
      }
      .title {
        text-align: center;
        font-weight: bold;
        font-size: 12pt;
        margin: 15px 0 20px 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .metin-paragraf {
        text-align: justify;
        line-height: 1.5;
        margin-bottom: 12px;
        text-indent: 20px;
      }
      .metin-paragraf-2 {
        text-align: justify;
        line-height: 1.5;
        margin-bottom: 25px;
        text-indent: 20px;
      }
      .yetkili-iletisim-row {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
      }
      .yetkili-iletisim-row td {
        vertical-align: top;
      }
      .iletisim-kutusu {
        font-size: 9.5pt;
        line-height: 1.4;
        color: #333;
      }
      .yetkili-tablo {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
      }
      .yetkili-kutusu {
        text-align: center;
        font-weight: bold;
        font-size: 11pt;
        line-height: 1.4;
      }
      .imza-label {
        margin-top: 15px;
      }
      .content-table {
        width: 100%;
        border-collapse: collapse;
        margin: 15px 0 25px 0;
        font-size: 10pt;
        page-break-inside: auto;
      }
      .content-table tr {
        page-break-inside: avoid;
        page-break-after: auto;
      }
      .content-table th,
      .content-table td {
        border: 1px solid #000;
        padding: 6px;
        vertical-align: middle;
      }
      .content-table th {
        font-weight: bold;
        text-align: center;
        background-color: #ffffff;
      }
      .taahhut-metni {
        text-align: left;
        font-size: 10.5pt;
        margin-bottom: 20px;
        text-indent: 20px;
      }
      .firma-kase-container {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        page-break-inside: avoid;
      }
      .firma-kase-container td {
        vertical-align: top;
        font-size: 10.5pt;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <div class="page-container">
      <!-- ANTET / LOGO HEADER (Standard Project Paged Header) -->
      <div class="paged-header" data-behavior="first-page-only" data-slot="top-center">
        <table class="header-table">
          <tr>
            <td style="width: 90px; text-align: left">
              {{#solLogo}}
              <img
                src="{{solLogo}}"
                alt="Sol Logo"
                style="max-width: 75px; max-height: 75px; object-fit: contain"
              />
              {{/solLogo}}
            </td>

            <td style="text-align: center; line-height: 1.3">
              {{#antetSatirlari}}
              <div style="font-weight: bold; font-size: 11.5pt">{{.}}</div>
              {{/antetSatirlari}} {{^antetSatirlari}}
              <div style="font-weight: bold; font-size: 11.5pt">T.C.</div>
              <div style="font-weight: bold; font-size: 11.5pt">
                {{#kurumUstBirim}}{{kurumUstBirim}}{{/kurumUstBirim}}{{^kurumUstBirim}}ADIYAMAN
                VALİLİĞİ{{/kurumUstBirim}}
              </div>
              <div style="font-weight: bold; font-size: 11.5pt">
                {{#kurumBirim}}{{kurumBirim}}{{/kurumBirim}}{{^kurumBirim}}İL MİLLİ EĞİTİM
                MÜDÜRLÜĞÜ{{/kurumBirim}}
              </div>
              <div style="font-weight: bold; font-size: 11.5pt">
                {{#kurumAdi}}{{kurumAdi}}{{/kurumAdi}}{{^kurumAdi}}Birsen Esensoy İlkokulu
                Müdürlüğü{{/kurumAdi}}
              </div>
              {{/antetSatirlari}}
            </td>

            <td style="width: 90px; text-align: right">
              {{#sagLogo}}
              <img
                src="{{sagLogo}}"
                alt="Sağ Logo"
                style="max-width: 75px; max-height: 75px; object-fit: contain"
              />
              {{/sagLogo}}
            </td>
          </tr>
        </table>
      </div>

      <div class="content-body">
        <!-- BAŞLIK -->
        <div class="title">YAKLAŞIK MALİYET TEKLİF MEKTUBU</div>

        <!-- MEVZUAT VE GEREKÇE METNİ -->
        <div class="metin-paragraf">
          4734 Sayılı K.İ.K.'nun İhale kurumu mal alımı ihaleleri uygulama yönetmeliğinin 7. maddesi
          hükümlerine göre yaklaşık maliyetin belirlenmesi gerekmektedir.
        </div>

        <div class="metin-paragraf-2">
          Müessesenizce temin olunabileceklerin kalite, evsaf, ve marka belirtmek suretiyle K.D.V
          hariç Yaklaşık birim fiyatların
          <b
            >{{#sonTeklifTarihi}}{{sonTeklifTarihi}}{{/sonTeklifTarihi}}{{^sonTeklifTarihi}}......../..../20....{{/sonTeklifTarihi}}</b
          >
          günü saat
          <b
            >{{#sonTeklifSaati}}{{sonTeklifSaati}}{{/sonTeklifSaati}}{{^sonTeklifSaati}}10:00{{/sonTeklifSaati}}</b
          >'a kadar verilmesi rica olunur.
        </div>

        <!-- YETKİLİ İMZA ALANI -->
        <table class="yetkili-tablo">
          <tbody>
            <tr>
              <td width="55%"></td>
              <td width="45%" align="center" class="yetkili-kutusu">
                <div>
                  {{#baskanAdi}}{{baskanAdi}}{{/baskanAdi}}{{^baskanAdi}}Bahri ALKAYIŞ{{/baskanAdi}}
                </div>
                <div>
                  {{#baskanUnvan}}{{baskanUnvan}}{{/baskanUnvan}}{{^baskanUnvan}}Okul
                  Müdürü{{/baskanUnvan}}
                </div>
                <div class="imza-label">İMZA</div>
              </td>
            </tr>
          </tbody>
        </table>

        <!-- MALZEME / HİZMET TABLOSU -->
        <table class="content-table">
          <thead>
            <tr>
              <th width="7%">S.NO</th>
              <th width="35%">MAL/HİZMET KALEMİNİN ADI</th>
              <th width="20%">ÖZELLİĞİ</th>
              <th width="10%">BİRİMİ</th>
              <th width="10%">MİKTARI</th>
              <th width="18%">BİRİM FİYATI (TL)</th>
            </tr>
          </thead>
          <tbody>
            {{#ihtiyacKalemleri}}
            <tr>
              <td align="center">{{siraNo}}</td>
              <td><b>{{malzemeAdi}}</b></td>
              <td>{{ozelligi}}</td>
              <td align="center">{{birimi}}</td>
              <td align="center">{{miktar}}</td>
              <td>{{birimFiyati}}</td>
            </tr>
            {{/ihtiyacKalemleri}} {{^ihtiyacKalemleri}}
            <tr>
              <td align="center">1</td>
              <td><b>A4 Fotokopi Kağıdı 500'lü - 5'li Paket</b></td>
              <td>En az 80 gr</td>
              <td align="center">Koli</td>
              <td align="center">1</td>
              <td></td>
            </tr>
            <tr>
              <td align="center">2</td>
              <td><b>Tükenmez Kalem</b></td>
              <td>Mavi</td>
              <td align="center">Adet</td>
              <td align="center">1</td>
              <td></td>
            </tr>
            {{/ihtiyacKalemleri}}
          </tbody>
        </table>

        <!-- TAAHHÜT VE FİRMA KAŞE/İMZA -->
        <div class="taahhut-metni">
          Yukarıda cins, miktar ve evsafı belirtilen işe ait yaklaşık birim fiyatı vermeyi kabul
          ederim.
        </div>

        <table class="firma-kase-container">
          <tbody>
            <tr>
              <td width="50%">
                TARİH :
                {{#teklifTarihi}}{{teklifTarihi}}{{/teklifTarihi}}{{^teklifTarihi}}......./..../20....{{/teklifTarihi}}
              </td>
              <td width="50%" align="right">FİRMA, İSİM, KAŞE</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </body>
</html>
