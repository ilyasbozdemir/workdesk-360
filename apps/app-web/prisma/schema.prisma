datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. KULLANICI & YETKİLENDİRME
model Kullanici {
  id        Int      @id @default(autoincrement())
  kurumId   Int?
  kurum     Kurum?   @relation(fields: [kurumId], references: [id], onDelete: SetNull)
  email     String   @unique
  adSoyad   String?
  sifreHash String
  rol       String   @default("user") // admin, user, viewer
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. KURUM & İDARİ ANTET (Multi-Tenancy Temeli)
model Kurum {
  id             Int                   @id @default(autoincrement())
  kurumKodu      String?               @unique
  kurumAdi       String
  il             String?
  ilce           String?
  vergiNo        String?
  vergiDairesi   String?
  telefon        String?
  eposta         String?
  adres          String?
  logoUrl        String?
  aktif          Boolean               @default(true)
  kullanicilar   Kullanici[]
  birimler       Birim[]
  personeller    Personel[]
  firmalar       Firma[]
  dosyalar       TeminDosyasi[]
  surecKayitlari EkosistemSurecKaydi[]
  senkronKayitlar EkosistemSenkronKaydi[]
  apiKeys        ApiKey[]
  gdriveAyarlari GoogleDriveAyarlari[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

// 3. KURUM BİRİMLERİ (TANIM_Birim)
model Birim {
  id             Int                   @id @default(autoincrement())
  kurumId        Int?
  kurum          Kurum?                @relation(fields: [kurumId], references: [id], onDelete: SetNull)
  birimAdi       String
  kod            String?
  aktif          Boolean               @default(true)
  dosyalar       TeminDosyasi[]
  surecKayitlari EkosistemSurecKaydi[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

// 4. PERSONEL & GÖREVLİLER (TANIM_Personel)
model Personel {
  id               Int           @id @default(autoincrement())
  kurumId          Int?
  kurum            Kurum?        @relation(fields: [kurumId], references: [id], onDelete: SetNull)
  adSoyad          String
  unvan            String?
  gorev            String?
  tcKimlikNo       String?
  telefon          String?
  eposta           String?
  aktif            Boolean       @default(true)
  komisyonGorevler KomisyonUye[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// 5. DOĞRUDAN TEMİN & İHALE DOSYASI (DATA_TeminDosyasi)
model TeminDosyasi {
  id                    Int               @id @default(autoincrement())
  kurumId               Int?
  kurum                 Kurum?            @relation(fields: [kurumId], references: [id], onDelete: SetNull)
  birimId               Int?
  birim                 Birim?            @relation(fields: [birimId], references: [id], onDelete: SetNull)
  dosyaNo               String
  isAdi                 String
  alimTuru              String            @default("mal") // mal, hizmet, yapim_isi, danismanlik
  usul                  String            @default("22_d") // 22_a, 22_b, 22_c, 22_d, ihale_19, ihale_21
  durum                 String            @default("taslak") // taslak, aktif, tamamlandi, iptal_edildi
  yil                   Int               @default(2026)
  yaklasikMaliyet       Decimal?          @db.Decimal(18, 2)
  sozlesmeBedeli        Decimal?          @db.Decimal(18, 2)
  kdvOrani              Int               @default(20)
  teklifSozlesmeTuru    String            @default("Birim Fiyat")
  sozlesmeYapilacakMi   Boolean           @default(false)
  kismiTeklifMi         Boolean           @default(false)
  
  harcamaYetkilisi      String?
  gerceklestirmeGorevli String?
  piyasaArastirmaGorevli String?
  
  acilisTarihi          DateTime?
  sonTeklifTarihi       DateTime?
  onayTarihi            DateTime?
  teslimTarihi          DateTime?
  
  kazananFirmaId        Int?
  kazananFirma          Firma?            @relation("KazananFirma", fields: [kazananFirmaId], references: [id], onDelete: SetNull)
  
  kalemler              Kalem[]
  teklifler             KalemTeklif[]
  komisyon              KomisyonUye[]
  belgeler              DosyaBelge[]
  sablonVerileri        DosyaSablonVeri[]
  yedekler              YedekKaydi[]
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([kurumId, dosyaNo])
}

// 6. MALZEME / HİZMET / İŞ KALEMLERİ (DATA_TeminKalem)
model Kalem {
  id               Int           @id @default(autoincrement())
  dosyaId          Int
  dosya            TeminDosyasi  @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  siraNo           Int           @default(1)
  malzemeAdi       String
  aciklama         String?
  miktar           Decimal       @db.Decimal(14, 4)
  birim            String        @default("Adet")
  yaklasikBirimFiyat Decimal?    @db.Decimal(18, 4)
  yaklasikToplam   Decimal?      @db.Decimal(18, 2)
  tasinirKodu      String?
  okasKodu         String?
  teklifler        KalemTeklif[]
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// 7. İSTEKLİ FİRMALAR (TANIM_Firma & DATA_TeminFirma)
model Firma {
  id                    Int            @id @default(autoincrement())
  kurumId               Int?
  kurum                 Kurum?         @relation(fields: [kurumId], references: [id], onDelete: SetNull)
  unvan                 String
  vergiNo               String?
  vergiDairesi          String?
  telefon               String?
  eposta                String?
  adres                 String?
  il                    String?
  ilce                  String?
  yetkili               String?
  yasakliMi             Boolean        @default(false)
  yasaklikKontrolTarihi DateTime?
  
  kazandigiDosyalar     TeminDosyasi[] @relation("KazananFirma")
  teklifler             KalemTeklif[]
  
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

// 8. TEKLİF MATRİSİ (DATA_TeminKalemTeklif)
model KalemTeklif {
  id           Int          @id @default(autoincrement())
  dosyaId      Int
  dosya        TeminDosyasi @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  kalemId      Int
  kalem        Kalem        @relation(fields: [kalemId], references: [id], onDelete: Cascade)
  firmaId      Int
  firma        Firma        @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  birimFiyat   Decimal      @db.Decimal(18, 4)
  toplamFiyat  Decimal      @db.Decimal(18, 2)
  paraBirimi   String       @default("TRY")
  kdvOrani     Int          @default(20)
  
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([kalemId, firmaId])
}

// 9. KOMİSYON ÜYELERİ (DATA_TeminKomisyon)
model KomisyonUye {
  id          Int          @id @default(autoincrement())
  dosyaId     Int
  dosya       TeminDosyasi @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  personelId  Int?
  personel    Personel?    @relation(fields: [personelId], references: [id], onDelete: SetNull)
  adSoyad     String
  unvan       String?
  gorev       String       @default("üye") // baskan, uye, yedek_uye
  siraNo      Int          @default(1)
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// 10. DOSYA BELGELERİ (DATA_DosyaBelgeler)
model DosyaBelge {
  id          Int          @id @default(autoincrement())
  dosyaId     Int
  dosya       TeminDosyasi @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  belgeTuru   String
  belgeAdi    String
  dosyaYolu   String?
  mimeType    String?
  boyutBytes  Int?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// 11. ŞABLON VERİ DEPOSU (DATA_DosyaSablonVeri)
model DosyaSablonVeri {
  id          Int          @id @default(autoincrement())
  dosyaId     Int
  dosya       TeminDosyasi @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  sablonKodu  String
  veriJson    String       @db.Text
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([dosyaId, sablonKodu])
}

// 12. API GÜVENLİĞİ & ERİŞİM ANAHTARLARI
model ApiKey {
  id          String    @id @default(uuid())
  kurumId     Int?
  kurum       Kurum?    @relation(fields: [kurumId], references: [id], onDelete: SetNull)
  key         String    @unique
  name        String
  scope       String    @default("admin") // admin, readonly, sync
  aktif       Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// 13. API LOGLARI
model ApiLog {
  id          Int       @id @default(autoincrement())
  endpoint    String
  method      String
  ipAdres     String?
  statusCode  Int
  sureMs      Int?
  hata        String?
  
  createdAt   DateTime  @default(now())
}

// 14. GOOGLE DRIVE VE YEDEKLEME MODELLERİ
model YedekKaydi {
  id              Int           @id @default(autoincrement())
  dosyaId         Int?
  dosya           TeminDosyasi? @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  hedef           String
  dosyaAdi        String
  boyutBytes      Int?
  gdriveFileId    String?
  aciklama        String?
  durum           String        @default("tamamlandi")
  
  createdAt       DateTime      @default(now())
}

model GoogleDriveAyarlari {
  id                Int       @id @default(autoincrement())
  kurumId           Int?
  kurum             Kurum?    @relation(fields: [kurumId], references: [id], onDelete: Cascade)
  clientId          String?
  clientSecret      String?
  refreshToken      String?
  folderId          String?
  autoBackup        Boolean   @default(false)
  lastBackupTime    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// 15. WORKDESK 360 EKOSİSTEM VE MEVZUAT SÜREÇ MODÜLLERİ (GENEL ŞABLON & ALGORİTMA KATMANI)
model EkosistemModulu {
  id            Int                   @id @default(autoincrement())
  moduleId      String                @unique // Örn: module-imar-kacak-yapi-3194, module-devlet-ihale-2886
  appId         String                @default("flowdesk-360") // temin-360, ihale-360, flowdesk-360, personel-360, disk-analiz-360, evraktron
  ad            String
  kanunDayanagi String?               // Örn: 3194 S.K. Md. 32/42, 2886 S.K., 4734 S.K., 2942 S.K.
  kategori      String                @default("workflow")
  versiyon      String                @default("1.0.0")
  manifestJson  String                @db.Text
  aktif         Boolean               @default(true)
  surecler      EkosistemSurecKaydi[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

// 16. ŞABLON TABANLI ÇOK AŞAMALI SÜREÇ ÖRNEKLERİ (3194 Kaçak Yapı, 2886 Devlet İhale, Kamulaştırma vb.)
model EkosistemSurecKaydi {
  id                     Int              @id @default(autoincrement())
  kurumId                Int?
  kurum                  Kurum?           @relation(fields: [kurumId], references: [id], onDelete: SetNull)
  birimId                Int?
  birim                  Birim?           @relation(fields: [birimId], references: [id], onDelete: SetNull)
  modulId                Int?
  modul                  EkosistemModulu? @relation(fields: [modulId], references: [id], onDelete: SetNull)
  surecNo                String
  baslik                 String
  appId                  String           @default("flowdesk-360")
  moduleCode             String           // Örn: module-imar-kacak-yapi-3194, module-devlet-ihale-2886
  flowId                 String           // Örn: flow-imar-kacak-yapi-3194
  durum                  String           @default("aktif") // taslak, aktif, tamamlandi, askida, iptal
  aktifAdimId            String?
  veriJson               String           @db.Text
  hesaplananSonuclarJson String?          @db.Text
  yasalSureBitis         DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([kurumId, surecNo])
}

// 17. ÇOKLU MASAÜSTÜ UYGULAMASI BULUT SENKRONİZASYON DEPOSU (Multi-App Cloud Sync)
model EkosistemSenkronKaydi {
  id         Int      @id @default(autoincrement())
  kurumId    Int?
  kurum      Kurum?   @relation(fields: [kurumId], references: [id], onDelete: SetNull)
  kayitId    String   @unique
  appId      String   @default("temin-360") // temin-360, ihale-360, flowdesk-360, personel-360, disk-analiz-360, evraktron
  moduleId   String?
  kayitTuru  String   @default("dosya") // dosya, surec, sablon, personel, envanter_raporu, evrak
  baslik     String
  veriJson   String   @db.Text
  token      String?
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
